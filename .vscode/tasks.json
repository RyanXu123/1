{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "编译并运行 (C)",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/c",
        "chcp 65001>nul & gcc -g -Wall \"${file}\" -o \"${fileBasenameNoExtension}.exe\" && \".\\${fileBasenameNoExtension}.exe\""
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "编译并运行 (C++)",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/c",
        "chcp 65001>nul & g++ -g -Wall \"${file}\" -o \"${fileBasenameNoExtension}.exe\" && \".\\${fileBasenameNoExtension}.exe\""
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "group": {
        "kind": "build"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "只编译 (C)",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/c",
        "chcp 65001>nul & gcc -g -Wall \"${file}\" -o \"${fileBasenameNoExtension}.exe\""
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
